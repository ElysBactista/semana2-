@inject IJSRuntime JS

<div class="d-flex flex-column h-100 p-3 text-white">
    <!-- ========================================================= -->
    <!-- 1. HEADER INSTITUCIONAL DGM (Logo / Escudo)               -->
    <!-- ========================================================= -->
    <div class="d-flex align-items-center gap-2 pb-3 mb-3 border-bottom border-white border-opacity-25">
        <i class="bi bi-shield-lock-fill fs-4 text-warning"></i>
        <span class="fs-5 fw-bold tracking-wide text-white">DGM</span>
    </div>

    <!-- ========================================================= -->
    <!-- 2. NAVEGACIÓN DINÁMICA CONDICIONADA POR ROL               -->
    <!-- ========================================================= -->
    <ul class="nav nav-pills flex-column gap-2 mb-auto">
        @if (rolUsuario == "Administrador")
        {
            <!-- VISTAS PARA ADMINISTRADOR / OFICIAL DE MIGRACIÓN -->
            <li class="nav-item">
                <NavLink class="nav-link text-white d-flex align-items-center gap-3 py-2 px-3 rounded-3" href="dashboard" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-1x2-fill fs-5"></i>
                    <span class="fw-medium">Panel General</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link text-white d-flex align-items-center gap-3 py-2 px-3 rounded-3" href="solicitudes">
                    <i class="bi bi-folder2-open fs-5"></i>
                    <span class="fw-medium">Gestión Solicitudes</span>
                </NavLink>
            </li>
        }
        else if (rolUsuario == "Residente" || rolUsuario == "Solicitante")
        {
            <!-- VISTAS PARA EL RESIDENTE / SOLICITANTE -->
            <li class="nav-item">
                <NavLink class="nav-link text-white d-flex align-items-center gap-3 py-2 px-3 rounded-3" href="mis-solicitudes" Match="NavLinkMatch.All">
                    <i class="bi bi-folder2-open fs-5"></i>
                    <span class="fw-medium">Mis Solicitudes</span>
                </NavLink>
            </li>
        }
        else
        {
            <!-- VISTA POR DEFECTO MIENTRAS CARGA EL ROL -->
            <li class="nav-item">
                <NavLink class="nav-link text-white d-flex align-items-center gap-3 py-2 px-3 rounded-3" href="dashboard">
                    <i class="bi bi-grid-1x2-fill fs-5"></i>
                    <span class="fw-medium">Inicio</span>
                </NavLink>
            </li>
        }
    </ul>

    <!-- ========================================================= -->
    <!-- 3. FOOTER DEL SIDEBAR                                     -->
    <!-- ========================================================= -->
    <div class="pt-3 border-top border-white border-opacity-25">
        <small class="text-white-50 d-block" style="font-size: 0.75rem;">Versión 1.0.0</small>
        <small class="text-white-50" style="font-size: 0.7rem;">DGM © 2026</small>
    </div>
</div>

<style>
    .nav-link {
        color: #ffffff !important;
        transition: background-color 0.2s ease, transform 0.1s ease;
    }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.15) !important;
            transform: translateX(3px);
        }

        .nav-link.active {
            background-color: #EE2A24 !important; /* Rojo institucional DGM */
            color: #ffffff !important;
            font-weight: 600;
        }
</style>

@code {
    // Almacena el rol recuperado de sessionStorage
    private string rolUsuario = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lee el rol activo para renderizar los accesos correspondientes
            rolUsuario = await JS.InvokeAsync<string>("sessionStorage.getItem", "rolUsuario") ?? string.Empty;
            StateHasChanged();
        }
    }
}