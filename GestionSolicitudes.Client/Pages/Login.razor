</div>

<style>
    /* Estilos Clave para Calcar la Plataforma DGM */
    .divPrincipalLogin {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: #f8f9fa;
        font-family: 'Poppins', sans-serif;
    }

    .curved-background {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, transparent 45%, #003876 45%);
        z-index: 1;
    }

    .image__login__logo {
        position: absolute;
        right: -0.001%;
        bottom: 5%;
        width: 480px;
        opacity: 0.10;
    }

    .login-content-layer {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 8vw;
    }

    .login__y__image {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }


    .divLogin {
        background: #ffffff;
        border-radius: 16px;
        padding: 2.5rem 2rem;
        width: 420px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        text-align: center;
    }

    .user__login--icon {
        width: 70px;
        height: 70px;
        margin: 1rem 0;
    }

    .user__text {
        font-size: 1.5rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 1.5rem;
    }

    .login__button {
        background-color: #0087FF;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        width: 100%;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.2s ease-in-out;
    }

    .login__button:hover {
        background-color: #0066cc;
    }

    .OcmLogo__Container {
        color: #ffffff;
        text-align: center;
        max-width: 500px;
    }

    .Ocm__Logo {
        width: 240px;
        height: auto;
        margin-bottom: 0.5rem;
    }

    .ocm_logo_text {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 0.5rem;
        opacity: 0.9;
    }
</style>

@code {
    private LoginDto loginModel = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private async Task ProcesarLogin()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginModel);
            var resultado = await response.Content.ReadFromJsonAsync<RespuestaAuthDto>();

            if (response.IsSuccessStatusCode && resultado != null && resultado.Exito)
            {
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                mensajeError = resultado?.Mensaje ?? "Credenciales inválidas.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error de conexión con el servidor: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    public class LoginDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaAuthDto
    {
        public bool Exito { get; set; }
        public string Token { get; set; } = string.Empty;
        public string Mensaje { get; set; } = string.Empty;
    }
}