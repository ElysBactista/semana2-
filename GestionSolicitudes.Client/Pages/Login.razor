                <div class="user__text"><span>Inicio de sesión</span></div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger py-2 mx-4 my-2 text-center" role="alert">
                        @mensajeError
                    </div>
                }

                <div class="divBtnLogin">
                    <EditForm Model="loginModel" OnValidSubmit="ProcesarLogin" class="editform">
                        <DataAnnotationsValidator />

                        <div class="form-floating mb-3">
                            <input type="email" autocomplete="username" placeholder="name@example.com" id="email" class="form-control" @bind-value="loginModel.Email" required />
                            <label for="email" class="form-label">Email</label>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <input type="password" autocomplete="current-password" placeholder="password" id="password" class="form-control" @bind-value="loginModel.Password" required />
                            <label for="password" class="form-label">Password</label>
                        </div>

                        <div class="button__content_login">
                            <button type="submit" class="login__button" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span>Cargando...</span>
                                }
                                else
                                {
                                    <span>Iniciar sesión</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
