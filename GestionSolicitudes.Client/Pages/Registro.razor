                    </g>
                    <text transform="matrix(1.0006 0 0 1 25.3106 535.0453)" fill="#003876" font-family="Marion" font-size="96.8px">REPÚBLICA DOMINICANA</text>
                    <rect x="455.21" y="598.03" fill="#E4262F" width="330.84" height="11"></rect>
                    <text transform="matrix(1.063 0 0 1 300.1211 730.3217)" fill="#E4262F" font-family="Marion" font-size="102.4415px" letter-spacing="0.94">MIGRACIÓN</text>
                </svg>

                <div class="user__icon">
                    <i class="bi bi-person-plus-fill fs-1" style="color: #003876;"></i>
                </div>

                <div class="user__text"><span>Crear Cuenta</span></div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger py-2 mx-2 mb-3 text-center small" role="alert">
                        @mensajeError
                    </div>
                }

                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success py-2 mx-2 mb-3 text-center small" role="alert">
                        @mensajeExito
                    </div>
                }

                <div class="divBtnLogin">
                    <EditForm Model="registroModel" OnValidSubmit="ProcesarRegistro" class="editform">
                        <DataAnnotationsValidator />

                        <!-- Correo Electrónico -->
                        <div class="form-floating mb-3">
                            <input type="email"
                                   id="regEmail"
                                   class="form-control"
                                   placeholder="correo@ejemplo.com"
                                   @bind-value="registroModel.Email"
                                   required />
                            <label for="regEmail" class="form-label">Correo electrónico</label>
                        </div>

                        <!-- Contraseña -->
                        <div class="position-relative mb-3">
                            <div class="form-floating">
                                <input type="@(mostrarPassword ? "text" : "password")"
                                       id="regPassword"
                                       class="form-control pe-5"
                                       placeholder="password"
                                       @bind-value="registroModel.Password"
                                       required />
                                <label for="regPassword" class="form-label">Contraseña</label>
                            </div>
                            <button type="button"
                                    class="btn position-absolute top-50 end-0 translate-middle-y me-2 border-0 text-muted"
                                    style="z-index: 5;"
                                    @onclick="ToggleMostrarPassword"
                                    tabindex="-1">
                                <i class="bi @(mostrarPassword ? "bi-eye-slash-fill" : "bi-eye-fill") fs-5"></i>
                            </button>
                        </div>

                        <!-- Confirmar Contraseña -->
                        <div class="form-floating mb-3">
                            <input type="password"
                                   id="regConfirmPassword"
                                   class="form-control"
                                   placeholder="confirm-password"
                                   @bind-value="confirmarPassword"
                                   required />
                            <label for="regConfirmPassword" class="form-label">Confirmar Contraseña</label>
                        </div>

                        <!-- Botón Crear Cuenta -->
                        <div class="button__content_login mb-3">
                            <button type="submit" class="login__button" disabled="@cargando">
                                @if (cargando)
                                {
                                    <span>Registrando...</span>
                                }
                                else
                                {
                                    <span>Registrarse</span>
                                }
                            </button>
                        </div>

                        <!-- Volver al Login -->
                        <div class="text-center">
                            <small class="text-muted">¿Ya tienes cuenta?</small>
                            <a href="/login" class="text-primary fw-semibold ms-1 small text-decoration-none">Inicia sesión</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .divPrincipalLogin {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: #f8f9fa;
        font-family: 'Poppins', sans-serif;
    }

    .curved-background {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
        height: 100%;
        background-color: #003876;
        clip-path: ellipse(110% 90% at 85% 100%);
        pointer-events: none;
        z-index: 1;
    }

    .image__login__logo {
        position: absolute;
        right: 6%;
        bottom: 12%;
        width: 440px;
        opacity: 0.10;
        z-index: 2;
        pointer-events: none;
    }

    .login-content-layer {
        position: relative;
        z-index: 10;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login__y__image {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .divLogin {
        background: #ffffff;
        border-radius: 16px;
        padding: 2rem 2rem;
        width: 420px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        text-align: center;
        position: relative;
        z-index: 11;
    }

    .user__icon {
        margin: 0.5rem 0;
    }

    .user__text {
        font-size: 1.4rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 1rem;
    }

    .login__button {
        background-color: #0087FF;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        width: 100%;
        padding: 0.75rem;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.2s ease-in-out;
    }

        .login__button:hover {
            background-color: #0066cc;
        }
</style>

@code {
    private RegistroModelo registroModel = new();
    private string confirmarPassword = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool cargando = false;
    private bool mostrarPassword = false;

    private void ToggleMostrarPassword() => mostrarPassword = !mostrarPassword;

    private async Task ProcesarRegistro()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        // Validación de coincidencia de contraseñas
        if (registroModel.Password != confirmarPassword)
        {
            mensajeError = "Las contraseñas no coinciden.";
            return;
        }

        cargando = true;

        try
        {
            var payload = new
            {
                Email = registroModel.Email,
                Password = registroModel.Password,
                Rol = "Residente" // Todo usuario nuevo que se registre toma rol Residente
            };

            var response = await Http.PostAsJsonAsync("api/auth/registro", payload);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = "¡Cuenta creada exitosamente! Redirigiendo al login...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorObj = await response.Content.ReadFromJsonAsync<RespuestaErrorDto>();
                mensajeError = errorObj?.Mensaje ?? "No se pudo completar el registro.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al conectar con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    public class RegistroModelo
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class RespuestaErrorDto
    {
        public bool Exito { get; set; }
        public string Mensaje { get; set; } = string.Empty;
    }
}